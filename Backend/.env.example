PORT=5000
NODE_ENV=development

# Local XAMPP/MySQL (empty root password) or Docker:
# DATABASE_URL=mysql://healthcart:healthcart@localhost:3306/healthcart
DATABASE_URL=mysql://root:@localhost:3306/healthcart

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=365d

CORS_ORIGIN=http://localhost:5173

# OTP delivery: sms | whatsapp | auto
# Message Central VerifyNow — https://cpaas.messagecentral.com
# Put customerId and authToken (JWT) from the dashboard. Do not commit real tokens.
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_AUTH_TOKEN=
MESSAGECENTRAL_COUNTRY=91
MESSAGECENTRAL_BASE_URL=https://cpaas.messagecentral.com
# Firebase Phone Auth: leave empty when Message Central is used
FIREBASE_WEB_API_KEY=
# SmsHorizon: API key from Developers → API Keys. Username is the panel login id.
OTP_CHANNEL=sms
SMSHORIZON_API_KEY=
SMSHORIZON_USER=
SMSHORIZON_SENDER=HORIZN
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=
FAST2SMS_API_KEY=
TWOFACTOR_API_KEY=

# Free WhatsApp (Green API): create an instance, scan QR, paste credentials
# https://green-api.com
# GREEN_API_INSTANCE_ID=
# GREEN_API_TOKEN=
# GREEN_API_URL=https://api.green-api.com

# Official WhatsApp Cloud API (1000 free conversations / month)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=
# WHATSAPP_OTP_TEMPLATE_LANG=en

# Free SMS OTP (India) — pick one
# 2Factor: https://2factor.in  (free OTP credits)
# TWOFACTOR_API_KEY=
# TWOFACTOR_TEMPLATE=OTP1
# Fast2SMS: https://www.fast2sms.com  (free OTP credits)
# FAST2SMS_API_KEY=
# TextBee (your Android phone as a free SMS gateway): https://textbee.dev
# TEXTBEE_API_KEY=
# TEXTBEE_DEVICE_ID=
# TEXTBELT_API_KEY=textbelt
